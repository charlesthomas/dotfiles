TCPKeepAlive yes
ServerAliveCountMax 100
ServerAliveInterval 15
ForwardAgent yes

# internal #
Host k3s1
    HostName 192.168.1.11

Host k3s2
    HostName 192.168.1.12

Host k3s3
    HostName 192.168.1.13

Host k3s4
    HostName 192.168.1.14

Host k3s5
    HostName 192.168.1.15

Host k3s6
    HostName 192.168.1.16

Host k3s7
    HostName 192.168.1.17

Host k3s*
    User k3s
    IdentityFile ~/.ssh/k3s.id_rsa

Host nas01*
    IdentityFile ~/.ssh/nas01.id_rsa

Host nas01
    HostName 192.168.1.21

Host nas02
    User admin
    HostName nas02.local

Host pihole2
    HostName pihole2.local
    IdentityFile ~/.ssh/pihole2.id_rsa

# external #
Host bitbucket.org
    User git

Host github.com
    User git
    IdentityFile ~/.ssh/github.id_rsa

Host gist.github.com
    User git

Host home*
    Hostname crt.lol
    IdentityFile ~/.ssh/pihole2.id_rsa

Host home-socks
    DynamicForward 127.0.0.1:8008

Host mini
    ProxyJump home
    IdentityFile ~/.ssh/mini.id_ed25519

Host mini-*
    HostName crt.lol
    IdentityFile ~/.ssh/pihol2.id_rsa

Host mini-prom
    LocalForward 3000 mini.local:3000
    LocalForward 8080 mini.local:8080
    LocalForward 9090 mini.local:9090

Host mini-vnc
    LocalForward 5900 mini.local:5900

Host seedbox
    HostName lucky.seedhost.eu
    User crthomas42
    IdentityFile ~/.ssh/seedbox_and_nas.id_rsa

Host offsite-backups
    User crthomas
    HostName offsite-backups.local
    IdentityFile ~/.ssh/ct-dev-box.id_ed25519

Host arborwood
    User crthomas
    HostName 192.168.2.5
    IdentityFile ~/.ssh/arborwood.id_ed25519
